#!/usr/bin/env bash
set -euo pipefail

# ---- colors ----
RED=$'\e[0;31m'
GREEN=$'\e[0;32m'
YELLOW=$'\e[1;33m'
BLUE=$'\e[0;34m'
PURPLE=$'\e[0;35m'
CYAN=$'\e[0;36m'
BOLD=$'\e[1m'
NC=$'\e[0m'

usage() {
  cat <<EOF
${BOLD}breakage${NC} - Search code for paths that will break if a folder is moved

${BOLD}Usage:${NC}
  breakage <folder> [search_path] [options]

${BOLD}Detailed Instructions:${NC}
  This tool identifies hardcoded references to a folder that will break on move.
  It uses "Confirmed Resolution" to verify if relative paths actually point to
  the target, reducing false positives from common folder names.

${BOLD}Options:${NC}
  ${BOLD}-h, --help${NC}
      Show this help message.
  ${BOLD}--no-filter${NC}
      Search all files instead of just common source code extensions.
  ${BOLD}--sudo${NC}
      Run search with sudo (useful for system-wide scans).

${BOLD}Examples:${NC}
  breakage /home/lewis/Dev / --no-filter --sudo
EOF
}

# ---- argument parsing ----
FOLDER=""
SEARCH_PATH=""
USE_FILTER=1
USE_SUDO=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --no-filter) USE_FILTER=0; shift ;;
    --sudo) USE_SUDO=1; shift ;;
    -*) echo -e "${RED}Unknown arg: $1${NC}" >&2; usage; exit 2 ;;
    *) 
      if [[ -z "$FOLDER" ]]; then FOLDER="$1"; shift
      elif [[ -z "$SEARCH_PATH" ]]; then SEARCH_PATH="$1"; shift
      else echo -e "${RED}Too many arguments.${NC}" >&2; usage; exit 2; fi
      ;;
  esac
done

[[ -z "$FOLDER" ]] && { usage; exit 2; }
SEARCH_PATH="${SEARCH_PATH:-.}"

# Tool detection
RG_BIN=""
command -v rg >/dev/null 2>&1 && RG_BIN="rg"

resolve_path() {
  if command -v realpath >/dev/null 2>&1;
  then
    realpath -m -- "$1" 2>/dev/null || echo "$1"
  else
    python3 - <<'PY' "$1" 2>/dev/null
import os, sys
print(os.path.normpath(os.path.abspath(sys.argv[1])))
PY
  fi
}

FOLDER_ABS="$(resolve_path "$FOLDER")"
FOLDER_NAME="$(basename "$FOLDER_ABS")"

FOLDER_HOME_ALT=""
if [[ "$FOLDER_ABS" == "$HOME"* ]]; then
  REL_TO_HOME="${FOLDER_ABS#$HOME/}"
  [[ "$REL_TO_HOME" != "$FOLDER_ABS" ]] && FOLDER_HOME_ALT="~/$REL_TO_HOME"
fi

SRC_GLOBS="*.{c,cpp,h,hpp,js,ts,py,rs,go,java,sh,rb,php,md,html,css,json,yaml,yml,toml}"
EXCLUDES=("proc" "sys" "dev" "run" "mnt" "tmp" ".git" ".cache" "node_modules" "venv" ".venv" "target")

# Shared search logic
SUDO_CMD=()
[[ "$USE_SUDO" -eq 1 ]] && SUDO_CMD=(sudo)

# Exclusions flags
RG_EXCLUDE_FLAGS=()
GREP_EXCLUDE_FLAGS=()
for x in "${EXCLUDES[@]}"; do
  RG_EXCLUDE_FLAGS+=("--glob" "!**/$x/**")
  GREP_EXCLUDE_FLAGS+=("--exclude-dir=$x")
done

echo -e "${BOLD}${PURPLE}== Analyzing potential breakage for moving: ${FOLDER_ABS} ==${NC}"
[[ -n "$FOLDER_HOME_ALT" ]] && echo -e "${CYAN}(Also checking for: ${FOLDER_HOME_ALT})${NC}"
echo -e "${CYAN}(Searching in: ${SEARCH_PATH} | Filter: $( [[ $USE_FILTER -eq 1 ]] && echo "Enabled" || echo "Disabled" ))${NC}"
echo

# Python helper for extraction AND context truncation
PY_HELPER=$(mktemp)
cat <<'EOF' > "$PY_HELPER"
import sys, re

mode = sys.argv[1] # 'extract' or 'truncate'
name_or_patt = sys.argv[2]
line = sys.stdin.read().strip()

if mode == 'extract':
    results = set()
    # Match anything in quotes (handle both hex-safe)
    for m in re.finditer(r"(['\x22])(.*?)\1", line):
        if name_or_patt in m.group(2): results.add(m.group(2))
    # Match words
    for word in re.split(r"[ \x22'():\[\]{}<>|,;]", line):
        if name_or_patt in word: results.add(word)
    for r in sorted(list(results)):
        if r: sys.stdout.write(r + '\n')

elif mode == 'truncate':
    idx = line.find(name_or_patt)
    if idx == -1:
        # Fallback to just the first 100 chars
        sys.stdout.write(line[:100] + "...\n")
    else:
        # Get ~40 chars on each side
        start = max(0, idx - 40)
        end = min(len(line), idx + len(name_or_patt) + 40)
        prefix = "..." if start > 0 else ""
        suffix = "..." if end < len(line) else ""
        sys.stdout.write(f"{prefix}{line[start:end]}{suffix}\n")
EOF
trap 'rm -f "$PY_HELPER"' EXIT

truncate_line() {
  local content="$1"
  local patt="$2"
  echo "$content" | python3 "$PY_HELPER" truncate "$patt"
}

# 1. Absolute Path Matches
echo -e "${BOLD}${BLUE}1) Absolute path references${NC}"
HAS_ABS=0

if [[ -n "$RG_BIN" ]]; then
  RG_ABS_ARGS=("${RG_EXCLUDE_FLAGS[@]}" "--color=never" "--no-messages" "--fixed-strings" "--vimgrep")
  [[ "$USE_FILTER" -eq 1 ]] && RG_ABS_ARGS+=("-g" "$SRC_GLOBS")
  
  while IFS=: read -r file line_num _ line_content; do
    HAS_ABS=1
    patt="$FOLDER_ABS"
    [[ "$line_content" == *"$FOLDER_HOME_ALT"* ]] && patt="$FOLDER_HOME_ALT"
    
    snippet=$(truncate_line "$line_content" "$patt")
    echo -e "${GREEN}$file:$line_num${NC}: $snippet"
  done < <("${SUDO_CMD[@]}" "$RG_BIN" "${RG_ABS_ARGS[@]}" -e "$FOLDER_ABS" ${FOLDER_HOME_ALT:+-e "$FOLDER_HOME_ALT"} "$SEARCH_PATH" 2>/dev/null || true)
else
  GREP_ABS_ARGS=("${GREP_EXCLUDE_FLAGS[@]}" "-rn" "--color=never" "-F")
  [[ "$USE_FILTER" -eq 1 ]] && GREP_ABS_ARGS+=("--include=$SRC_GLOBS")
  
  while IFS=: read -r file line_num line_content; do
    HAS_ABS=1
    patt="$FOLDER_ABS"
    [[ "$line_content" == *"$FOLDER_HOME_ALT"* ]] && patt="$FOLDER_HOME_ALT"
    
    snippet=$(truncate_line "$line_content" "$patt")
    echo -e "${GREEN}$file:$line_num${NC}: $snippet"
  done < <("${SUDO_CMD[@]}" grep "${GREP_ABS_ARGS[@]}" -e "$FOLDER_ABS" ${FOLDER_HOME_ALT:+-e "$FOLDER_HOME_ALT"} "$SEARCH_PATH" 2>/dev/null || true)
fi
[[ $HAS_ABS -eq 0 ]] && echo -e "${YELLOW}No absolute path matches found.${NC}"

echo
echo -e "${BOLD}${BLUE}2) Confirmed relative references to '${FOLDER_NAME}'${NC}"
echo -e "${CYAN}(Verifying if paths actually resolve to the target directory)${NC}"

process_hit() {
  local file="$1" line_num="$2" line_content="$3"
  local file_dir="$(dirname "$file")"
  [[ "$file_dir" != /* ]] && file_dir="$PWD/$file_dir"

  local potentials=""
  potentials=$(echo "$line_content" | python3 "$PY_HELPER" extract "$FOLDER_NAME" 2>/dev/null || true)

  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    local resolved=""
    if [[ "$p" == "~/*" ]]; then resolved="$(resolve_path "${p/#	/$HOME}")"
    elif [[ "$p" == /* ]]; then resolved="$(resolve_path "$p")"
    else
      if [[ "$p" == "$FOLDER_NAME" ]]; then
         local has_slash=0; [[ "$line_content" == *"/"* ]] && has_slash=1
         local is_quoted=0; [[ "$line_content" == *"'$FOLDER_NAME'"* || "$line_content" == *"\"$FOLDER_NAME\""* ]] && is_quoted=1
         [[ $has_slash -eq 0 && $is_quoted -eq 0 ]] && continue
      fi
      resolved="$(resolve_path "$file_dir/$p")"
    fi
    if [[ -n "$resolved" ]] && [[ "$resolved" == "$FOLDER_ABS" || "$resolved" == "$FOLDER_ABS"/* ]]; then
      snippet=$(truncate_line "$line_content" "$p")
      echo -e "${GREEN}$file:$line_num${NC}: $snippet ${BOLD}${GREEN}[CONFIRMED]${NC} (via: $p)"
      break
    fi
  done <<< "$potentials"
}

MAX_HITS=5000; hit_count=0
if [[ -n "$RG_BIN" ]]; then
  RG_REL_ARGS=("${RG_EXCLUDE_FLAGS[@]}" "--color=never" "--no-messages" "-w" "$FOLDER_NAME" "--vimgrep" "--glob" "!**/${FOLDER_NAME}/**")
  [[ "$USE_FILTER" -eq 1 ]] && RG_REL_ARGS+=("-g" "$SRC_GLOBS")
  
  while IFS=: read -r file line_num _ line_content; do
    process_hit "$file" "$line_num" "$line_content"
    ((hit_count++)); [[ $hit_count -ge $MAX_HITS ]] && { echo -e "${YELLOW}Warning: Hit limit reached ($MAX_HITS).${NC}" >&2; break; }
  done < <("${SUDO_CMD[@]}" "$RG_BIN" "${RG_REL_ARGS[@]}" "$SEARCH_PATH" 2>/dev/null || true)
else
  GREP_REL_ARGS=("${GREP_EXCLUDE_FLAGS[@]}" "-rn" "--color=never" "-w" "$FOLDER_NAME" "--exclude-dir=$FOLDER_NAME")
  [[ "$USE_FILTER" -eq 1 ]] && GREP_REL_ARGS+=("--include=$SRC_GLOBS")

  while IFS=: read -r file line_num line_content; do
    process_hit "$file" "$line_num" "$line_content"
    ((hit_count++)); [[ $hit_count -ge $MAX_HITS ]] && { echo -e "${YELLOW}Warning: Hit limit reached ($MAX_HITS).${NC}" >&2; break; }
  done < <("${SUDO_CMD[@]}" grep "${GREP_REL_ARGS[@]}" "$SEARCH_PATH" 2>/dev/null || true)
fi

echo; echo -e "${BOLD}${GREEN}Done.${NC}"