#!/usr/bin/env bash
set -euo pipefail

# ---- colors ----
RED=$'\e[0;31m'
GREEN=$'\e[0;32m'
YELLOW=$'\e[1;33m'
BLUE=$'\e[0;34m'
PURPLE=$'\e[0;35m'
CYAN=$'\e[0;36m'
BOLD=$'\e[1m'
NC=$'\e[0m'

usage() {
  cat <<EOF
${BOLD}breakage${NC} - Search code for paths that will break if a folder is moved

${BOLD}Usage:${NC}
  breakage <folder> [search_path] [options]

${BOLD}What it does:${NC}
  Finds references to <folder> that would break if <folder> is moved/renamed:
    1) Absolute path references (e.g. /home/lewis/Dev/...)
    2) Confirmed relative references that resolve into <folder> (reduces false positives)

${BOLD}Options:${NC}
  ${BOLD}-h, --help${NC}
      Show this help message.
  ${BOLD}--no-filter${NC}
      Search all files instead of just common source/config extensions.
  ${BOLD}--no-truncate${NC}
      Show full line content instead of a truncated snippet.
  ${BOLD}--sudo${NC}
      Run search with sudo (useful for system-wide scans).

${BOLD}Examples:${NC}
  breakage /home/lewis/Dev .
  breakage /home/lewis/Dev ~ --no-filter
  breakage /home/lewis/Dev /etc --no-filter --sudo
  breakage /home/lewis/Dev / --no-filter --sudo
EOF
}

# ---- argument parsing ----
FOLDER=""
SEARCH_PATH=""
USE_FILTER=1
USE_SUDO=0
DO_TRUNCATE=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --no-filter) USE_FILTER=0; shift ;;
    --no-truncate) DO_TRUNCATE=0; shift ;;
    --sudo) USE_SUDO=1; shift ;;
    -*) echo -e "${RED}Unknown arg: $1${NC}" >&2; usage; exit 2 ;;
    *)
      if [[ -z "$FOLDER" ]]; then
        FOLDER="$1"; shift
      elif [[ -z "$SEARCH_PATH" ]]; then
        SEARCH_PATH="$1"; shift
      else
        echo -e "${RED}Too many arguments.${NC}" >&2
        usage
        exit 2
      fi
      ;;
  esac
done

[[ -z "$FOLDER" ]] && { usage; exit 2; }
SEARCH_PATH="${SEARCH_PATH:-.}"

# Tool detection
RG_BIN=""
command -v rg >/dev/null 2>&1 && RG_BIN="rg"

resolve_path() {
  # Resolve as best-effort, without requiring the path to exist.
  if command -v realpath >/dev/null 2>&1; then
    realpath -m -- "$1" 2>/dev/null || echo "$1"
  else
    python3 - <<'PY' "$1" 2>/dev/null
import os, sys
print(os.path.normpath(os.path.abspath(sys.argv[1])))
PY
  fi
}

FOLDER_ABS="$(resolve_path "$FOLDER")"
FOLDER_NAME="$(basename "$FOLDER_ABS")"

FOLDER_HOME_ALT=""
if [[ "$FOLDER_ABS" == "$HOME"* ]]; then
  REL_TO_HOME="${FOLDER_ABS#$HOME/}"
  [[ "$REL_TO_HOME" != "$FOLDER_ABS" ]] && FOLDER_HOME_ALT="~/$REL_TO_HOME"
fi

# Common source/config extensions (rg supports this brace form; grep does not)
SRC_GLOBS_RG="*.{c,cpp,h,hpp,js,ts,py,rs,go,java,sh,rb,php,md,html,css,json,yaml,yml,toml}"
SRC_EXTS_GREP=(c cpp h hpp js ts py rs go java sh rb php md html css json yaml yml toml)

# Directories to exclude by default (esp. important for "/" scans)
EXCLUDES=(
  "proc" "sys" "dev" "run" "mnt" "tmp" "var/tmp" "var/cache" "var/log" "var/lib"
  ".git" ".cache" "node_modules" "venv" ".venv" "target"
  "snap"
  "gemini" ".gemini" "codex" ".codex"
)

SUDO_CMD=()
[[ "$USE_SUDO" -eq 1 ]] && SUDO_CMD=(sudo)

# Exclusion flags
RG_EXCLUDE_FLAGS=()
GREP_EXCLUDE_FLAGS=()
for x in "${EXCLUDES[@]}"; do
  # Exclude top-level and nested occurrences, recursively.
  RG_EXCLUDE_FLAGS+=("--glob" "!${x}/**" "--glob" "!**/${x}/**")
  GREP_EXCLUDE_FLAGS+=("--exclude-dir=$x")
done

echo -e "${BOLD}${PURPLE}== Analyzing potential breakage for moving: ${FOLDER_ABS} ==${NC}"
[[ -n "$FOLDER_HOME_ALT" ]] && echo -e "${CYAN}(Also checking for: ${FOLDER_HOME_ALT})${NC}"
echo -e "${CYAN}(Searching in: ${SEARCH_PATH} | Filter: $( [[ $USE_FILTER -eq 1 ]] && echo "Enabled" || echo "Disabled" ) | Sudo: $( [[ $USE_SUDO -eq 1 ]] && echo "Yes" || echo "No" ))${NC}"
echo

# Create a temporary python helper script
PY_HELPER="$(mktemp)"
cat <<'EOF' > "$PY_HELPER"
import sys, re

mode = sys.argv[1]  # 'extract' or 'truncate'
needle = sys.argv[2]
line = sys.stdin.read().rstrip("\n")

if mode == 'extract':
    results = set()

    # Extract quoted strings first (single or double quotes)
    for m in re.finditer(r"(['\x22])(.*?)\1", line):
        s = m.group(2)
        if needle in s:
            results.add(s)

    # Then extract rough "tokens" (paths often appear as tokens)
    for word in re.split(r"[ \x22'():\[\]{}<>|,;]", line):
        if needle in word:
            results.add(word)

    for r in sorted(results):
        if r:
            sys.stdout.write(r + "\n")

elif mode == 'truncate':
    idx = line.find(needle)
    if idx == -1:
        sys.stdout.write((line[:100] + "...\n") if len(line) > 100 else (line + "\n"))
    else:
        start = max(0, idx - 60)
        end = min(len(line), idx + len(needle) + 60)
        prefix = "..." if start > 0 else ""
        suffix = "..." if end < len(line) else ""
        sys.stdout.write(f"{prefix}{line[start:end]}{suffix}\n")
EOF
trap 'rm -f "$PY_HELPER"' EXIT

display_line() {
  local content="$1"
  local patt="$2"
  if [[ "$DO_TRUNCATE" -eq 1 ]]; then
    printf "%s" "$content" | python3 "$PY_HELPER" truncate "$patt"
  else
    printf "%s\n" "$content"
  fi
}

# =========================
# 1) Absolute Path Matches
# =========================
echo -e "${BOLD}${BLUE}1) Absolute path references${NC}"
HAS_ABS=0
declare -A SEEN_ABS=()

if [[ -n "$RG_BIN" ]]; then
  # IMPORTANT: put include globs first, exclude globs last (rg is last-match-wins)
  RG_ABS_ARGS=("--color=never" "--no-messages" "--fixed-strings" "--vimgrep")
  [[ "$USE_FILTER" -eq 1 ]] && RG_ABS_ARGS+=("-g" "$SRC_GLOBS_RG")
  RG_ABS_ARGS+=("${RG_EXCLUDE_FLAGS[@]}")

  while IFS=: read -r file line_num _ line_content; do
    [[ -z "${file:-}" ]] && continue

    # Deduplicate by file:line (avoids duplicates when multiple -e patterns hit same line)
    key="$file:$line_num"
    [[ -n "${SEEN_ABS[$key]:-}" ]] && continue
    SEEN_ABS[$key]=1

    # Skip if this script itself appears in results (when searching widely)
    if [[ "$(resolve_path "$file")" == "$(resolve_path "$0")" ]]; then
      continue
    fi

    HAS_ABS=1
    patt="$FOLDER_ABS"
    [[ -n "$FOLDER_HOME_ALT" && "$line_content" == *"$FOLDER_HOME_ALT"* ]] && patt="$FOLDER_HOME_ALT"
    snippet="$(display_line "$line_content" "$patt")"
    echo -e "${GREEN}$file:$line_num${NC}: $snippet"
  done < <("${SUDO_CMD[@]}" "$RG_BIN" "${RG_ABS_ARGS[@]}" -e "$FOLDER_ABS" ${FOLDER_HOME_ALT:+-e "$FOLDER_HOME_ALT"} "$SEARCH_PATH" 2>/dev/null || true)
else
  # Grep fallback: implement filtering via multiple --include patterns (grep doesn't understand brace globs)
  GREP_ABS_ARGS=("${GREP_EXCLUDE_FLAGS[@]}" "-rn" "--color=never" "-F")
  if [[ "$USE_FILTER" -eq 1 ]]; then
    for ext in "${SRC_EXTS_GREP[@]}"; do
      GREP_ABS_ARGS+=("--include=*.${ext}")
    done
  fi

  while IFS=: read -r file line_num line_content; do
    [[ -z "${file:-}" ]] && continue

    key="$file:$line_num"
    [[ -n "${SEEN_ABS[$key]:-}" ]] && continue
    SEEN_ABS[$key]=1

    if [[ "$(resolve_path "$file")" == "$(resolve_path "$0")" ]]; then
      continue
    fi

    HAS_ABS=1
    patt="$FOLDER_ABS"
    [[ -n "$FOLDER_HOME_ALT" && "$line_content" == *"$FOLDER_HOME_ALT"* ]] && patt="$FOLDER_HOME_ALT"
    snippet="$(display_line "$line_content" "$patt")"
    echo -e "${GREEN}$file:$line_num${NC}: $snippet"
  done < <("${SUDO_CMD[@]}" grep "${GREP_ABS_ARGS[@]}" -e "$FOLDER_ABS" ${FOLDER_HOME_ALT:+-e "$FOLDER_HOME_ALT"} "$SEARCH_PATH" 2>/dev/null || true)
fi

[[ $HAS_ABS -eq 0 ]] && echo -e "${YELLOW}No absolute path matches found.${NC}"

echo
echo -e "${BOLD}${BLUE}2) Confirmed relative references to '${FOLDER_NAME}'${NC}"
echo -e "${CYAN}(Verifying if paths actually resolve to the target directory)${NC}"

process_hit() {
  local file="$1" line_num="$2" line_content="$3"

  local file_dir
  file_dir="$(dirname -- "$file")"
  file_dir="$(resolve_path "$file_dir")"

  local potentials
  potentials="$(printf "%s" "$line_content" | python3 "$PY_HELPER" extract "$FOLDER_NAME" 2>/dev/null || true)"

  while IFS= read -r p; do
    [[ -z "$p" ]] && continue

    if [[ "$p" == "$FOLDER_NAME" ]]; then
      local has_slash=0 is_quoted=0
      [[ "$line_content" == *"/"* ]] && has_slash=1
      [[ "$line_content" == *"'$FOLDER_NAME'"* || "$line_content" == *"\"$FOLDER_NAME\""* ]] && is_quoted=1
      [[ $has_slash -eq 0 && $is_quoted -eq 0 ]] && continue
    fi

    local resolved=""
    if [[ "$p" == "~/"* ]]; then
      resolved="$(resolve_path "${p/#\~/$HOME}")"
    elif [[ "$p" == /* ]]; then
      resolved="$(resolve_path "$p")"
    else
      resolved="$(resolve_path "$file_dir/$p")"
    fi

    if [[ -n "$resolved" ]] && [[ "$resolved" == "$FOLDER_ABS" || "$resolved" == "$FOLDER_ABS"/* ]]; then
      local snippet
      snippet="$(display_line "$line_content" "$p")"
      echo -e "${GREEN}$file:$line_num${NC}: $snippet ${BOLD}${GREEN}[CONFIRMED]${NC} (via: $p)"
      break
    fi
  done <<< "$potentials"
}

MAX_HITS=5000
hit_count=0

if [[ -n "$RG_BIN" ]]; then
  # IMPORTANT: include first, exclude last (last-match-wins)
  RG_REL_ARGS=("--color=never" "--no-messages" "-w" "$FOLDER_NAME" "--vimgrep" "--glob" "!**/${FOLDER_NAME}/**")
  [[ "$USE_FILTER" -eq 1 ]] && RG_REL_ARGS+=("-g" "$SRC_GLOBS_RG")
  RG_REL_ARGS+=("${RG_EXCLUDE_FLAGS[@]}")

  while IFS=: read -r file line_num _ line_content; do
    [[ -z "${file:-}" ]] && continue

    if [[ "$(resolve_path "$file")" == "$(resolve_path "$0")" ]]; then
      continue
    fi

    process_hit "$file" "$line_num" "$line_content"
    ((hit_count += 1))
    [[ $hit_count -ge $MAX_HITS ]] && { echo -e "${YELLOW}Warning: Hit limit reached ($MAX_HITS).${NC}" >&2; break; }
  done < <("${SUDO_CMD[@]}" "$RG_BIN" "${RG_REL_ARGS[@]}" "$SEARCH_PATH" 2>/dev/null || true)
else
  GREP_REL_ARGS=("${GREP_EXCLUDE_FLAGS[@]}" "-rn" "--color=never" "-w" "$FOLDER_NAME" "--exclude-dir=$FOLDER_NAME")
  if [[ "$USE_FILTER" -eq 1 ]]; then
    for ext in "${SRC_EXTS_GREP[@]}"; do
      GREP_REL_ARGS+=("--include=*.${ext}")
    done
  fi

  while IFS=: read -r file line_num line_content; do
    [[ -z "${file:-}" ]] && continue

    if [[ "$(resolve_path "$file")" == "$(resolve_path "$0")" ]]; then
      continue
    fi

    process_hit "$file" "$line_num" "$line_content"
    ((hit_count += 1))
    [[ $hit_count -ge $MAX_HITS ]] && { echo -e "${YELLOW}Warning: Hit limit reached ($MAX_HITS).${NC}" >&2; break; }
  done < <("${SUDO_CMD[@]}" grep "${GREP_REL_ARGS[@]}" "$SEARCH_PATH" 2>/dev/null || true)
fi

echo
echo -e "${BOLD}${GREEN}Done.${NC}"
