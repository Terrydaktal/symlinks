#!/usr/bin/env bash
set -euo pipefail

# ---- colors ----
RED=$'\e[0;31m'
GREEN=$'\e[0;32m'
YELLOW=$'\e[1;33m'
BLUE=$'\e[0;34m'
PURPLE=$'\e[0;35m'
CYAN=$'\e[0;36m'
BOLD=$'\e[1m'
NC=$'\e[0m'

usage() {
  cat <<EOF
${BOLD}symlinks${NC} - Audit and analyze symlinks for a directory

${BOLD}Usage:${NC}
  symlinks <folder> [options]

${BOLD}Detailed Instructions:${NC}
  This tool helps you understand the symlink relationships of a specific folder.
  It categorizes links into three groups:

  ${BOLD}1) Incoming Symlinks (System -> Folder)${NC}
     Finds links elsewhere on the system that point to targets inside <folder>.
     Moving <folder> will break these links.

  ${BOLD}2) Internal Symlinks (Folder -> Folder)${NC}
     Links inside <folder> that point to targets also inside <folder>.
     - ${GREEN}Relative${NC} internal links stay valid if <folder> is moved.
     - ${RED}Absolute${NC} internal links break if <folder> is moved.

  ${BOLD}3) External Symlinks (Folder -> Outside)${NC}
     Links inside <folder> that point to targets outside <folder>.
     - ${GREEN}Absolute${NC} external links stay valid if <folder> is moved.
     - ${RED}Relative${NC} external links might break if they depend on the
       folder's position relative to the target.

${BOLD}Markers:${NC}
  ${BOLD}${RED}[BROKEN NOW]${NC}
      The symlink is dangling (target does not exist).
  ${BOLD}${RED}[BROKEN IF MOVED]${NC}
      The symlink will break if <folder> is moved to a different location.

${BOLD}Options:${NC}
  ${BOLD}-h, --help${NC}
      Show this detailed help message.
  ${BOLD}--root <scan_root>${NC}
      Where to start scanning for "incoming" links (default: "/").
  ${BOLD}--no-sudo${NC}
      Do not use sudo for the system-wide scan.
  ${BOLD}--no-system-scan${NC}
      Skip scanning the system for incoming links. Only check links inside <folder>.

${BOLD}Examples:${NC}
  symlinks .
  symlinks /home/user/projects/my-project --root /var/www
EOF
}

# ---- argument parsing ----
FOLDER=""
SCAN_ROOT="/"
USE_SUDO="auto"
DO_SYSTEM_SCAN=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage; exit 0
      ;;
    --root)
      SCAN_ROOT="${2:?--root requires a path}"; shift 2
      ;;
    --no-sudo)
      USE_SUDO="no"; shift
      ;;
    --no-system-scan)
      DO_SYSTEM_SCAN=0; shift
      ;;
    -*)
      echo -e "${RED}Unknown arg: $1${NC}" >&2
      usage; exit 2
      ;;
    *)
      if [[ -z "$FOLDER" ]]; then
        FOLDER="$1"; shift
      else
        echo -e "${RED}Multiple folders specified: $FOLDER and $1${NC}" >&2
        usage; exit 2
      fi
      ;;
  esac
done

if [[ -z "$FOLDER" ]]; then
  usage
  exit 2
fi

# ---- tool detection ----
FD_BIN=""
if command -v fd >/dev/null 2>&1; then
  FD_BIN="fd"
elif command -v fdfind >/dev/null 2>&1; then
  FD_BIN="fdfind"
fi

if ! command -v readlink >/dev/null 2>&1; then
  echo -e "${RED}Error: readlink not found.${NC}" >&2
  exit 1
fi

# Fully resolve a path (follows symlink chain if it's a symlink),
# but tolerate missing components (-m). If realpath missing, use python.
resolve_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath -m -- "$1"
  else
    python3 - <<'PY' "$1"
import os, sys
p = sys.argv[1]
print(os.path.normpath(os.path.abspath(p)))
PY
  fi
}

# Normalize a path string WITHOUT dereferencing symlinks.
# This is lexical join+normalize only.
normalize_noderef() {
  if command -v realpath >/dev/null 2>&1; then
    realpath -m --no-symlinks -- "$1"
  elif readlink -m / >/dev/null 2>&1; then
    readlink -m -- "$1"
  else
    python3 - <<'PY' "$1"
import os, sys
p = sys.argv[1]
print(os.path.normpath(os.path.abspath(p)))
PY
  fi
}

FOLDER_ABS="$(resolve_path "$FOLDER")"
SCAN_ROOT_ABS="$(resolve_path "$SCAN_ROOT")"

if [[ ! -d "$FOLDER_ABS" ]]; then
  echo -e "${RED}Error: folder does not exist or is not a directory: ${FOLDER_ABS}${NC}" >&2
  exit 1
fi

# ---- marker helper ----
make_markers() {
  local broken_now="${1:-0}"
  local broken_if_moved="${2:-0}"
  local m=""
  if [[ "$broken_now" -eq 1 ]]; then
    m+=" ${BOLD}${RED}[BROKEN NOW]${NC}"
  fi
  if [[ "$broken_if_moved" -eq 1 ]]; then
    m+=" ${BOLD}${RED}[BROKEN IF MOVED]${NC}"
  fi
  printf "%b" "$m"
}

# Determine sudo prefix if needed
sudo_prefix=()
if [[ "$USE_SUDO" == "auto" ]]; then
  if [[ "${EUID:-$(id -u)}" -ne 0 ]] && command -v sudo >/dev/null 2>&1; then
    sudo_prefix=(sudo)
  fi
elif [[ "$USE_SUDO" == "no" ]]; then
  sudo_prefix=()
fi

# ---- 1) Incoming: Symlinks from other folders into FOLDER_ABS ----
if [[ "$DO_SYSTEM_SCAN" -eq 1 ]]; then
  if [[ -z "$FD_BIN" ]]; then
    echo -e "${YELLOW}Warning: fd/fdfind not found; skipping incoming scan.${NC}" >&2
  else
    echo -e "${BOLD}${PURPLE}== 1: Incoming Symlinks (Outside -> ${FOLDER_ABS}) ==${NC}"
    echo -e "${CYAN}(These are sensitive to moving ${FOLDER_ABS}; [BROKEN NOW] means the target is missing today)${NC}"

    "${sudo_prefix[@]}" "$FD_BIN" -t l -H --absolute-path . "$SCAN_ROOT_ABS" \
      -E proc -E sys -E dev -E run -E mnt -E tmp -E .git -E .cache -E node_modules \
      -x bash -c '
        set -euo pipefail
        folder_abs="$1"; shift

        resolve_path_inner() {
          if command -v realpath >/dev/null 2>&1; then
            realpath -m -- "$1" 2>/dev/null || true
          else
            python3 - <<PY "$1" 2>/dev/null || true
import os, sys
print(os.path.normpath(os.path.abspath(sys.argv[1])))
PY
          fi
        }

        make_markers_inner() {
          broken_now="${1:-0}"
          broken_if_moved="${2:-0}"
          m=""
          if [[ "$broken_now" -eq 1 ]]; then
            m+=" \e[1m\e[0;31m[BROKEN NOW]\e[0m"
          fi
          if [[ "$broken_if_moved" -eq 1 ]]; then
            m+=" \e[1m\e[0;31m[BROKEN IF MOVED]\e[0m"
          fi
          printf "%b" "$m"
        }

        for link in "$@"; do
          # Skip links that are inside the folder (incoming scan is outside -> folder)
          case "$link" in
            "$folder_abs"|"$folder_abs"/*) continue ;;
          esac

          resolved="$(resolve_path_inner "$link")"
          [[ -z "$resolved" ]] && continue

          case "$resolved" in
            "$folder_abs"|"$folder_abs"/*)
              raw="$(readlink -- "$link" 2>/dev/null || true)"
              [[ -z "$raw" ]] && continue

              # Broken-now: test the symlink with -e (follows it). If target missing => false.
              broken_now=0
              if [[ ! -e "$link" ]]; then
                broken_now=1
              fi

              markers="$(make_markers_inner "$broken_now" 1)"
              printf "\e[0;34m%s\e[0m -> \e[1;33m%s\e[0m (\e[0;36mresolved: %s\e[0m)%b\n" \
                "$link" "$raw" "$resolved" "$markers"
              ;;
          esac
        done
      ' bash "$FOLDER_ABS" {} +

    echo
  fi
fi

# We scan symlinks inside the folder once and classify them.
declare -a INTERNAL_LINES=()
declare -a EXTERNAL_LINES=()

while IFS= read -r -d '' link; do
  raw="$(readlink -- "$link" 2>/dev/null || true)"
  [[ -z "$raw" ]] && continue

  # Broken-now: does the symlink currently resolve to something that exists?
  broken_now=0
  if [[ ! -e "$link" ]]; then
    broken_now=1
  fi

  # Full resolution (may dereference chain)
  resolved="$(resolve_path "$link")"

  # Immediate target: dirname(link)+raw, lexical-normalized WITHOUT dereferencing
  if [[ "$raw" == /* ]]; then
    immediate_target_abs="$raw"
  else
    immediate_target_abs="$(normalize_noderef "$(dirname -- "$link")/$raw")"
  fi

  if [[ "$resolved" == "$FOLDER_ABS" || "$resolved" == "$FOLDER_ABS"/* ]]; then
    # INTERNAL (eventually points inside the folder)
    broken_if_moved=0
    if [[ "$raw" == /* ]]; then
      # Absolute internal targets hardcode the folder path
      broken_if_moved=1
    fi
    markers="$(make_markers "$broken_now" "$broken_if_moved")"
    INTERNAL_LINES+=(
      "$(printf "${GREEN}%s${NC} -> ${YELLOW}%s${NC} (${CYAN}resolved: %s${NC})%b" "$link" "$raw" "$resolved" "$markers")"
    )
  else
    # EXTERNAL (eventually points outside the folder)
    broken_if_moved=0
    if [[ "$raw" != /* ]]; then
      # Relative external link breaks if its immediate target is outside the folder
      if [[ "$immediate_target_abs" != "$FOLDER_ABS" && "$immediate_target_abs" != "$FOLDER_ABS"/* ]]; then
        broken_if_moved=1
      fi
    fi
    markers="$(make_markers "$broken_now" "$broken_if_moved")"
    EXTERNAL_LINES+=(
      "$(printf "${RED}%s${NC} -> ${YELLOW}%s${NC} (${CYAN}resolved: %s${NC})%b" "$link" "$raw" "$resolved" "$markers")"
    )
  fi
done < <(find "$FOLDER_ABS" -type l -print0 2>/dev/null)

# ---- 2) Internal ----
echo -e "${BOLD}${GREEN}== 2: Internal Symlinks (${FOLDER_ABS} -> ${FOLDER_ABS}) ==${NC}"
echo -e "${CYAN}(Absolute internal links break if moved; [BROKEN NOW] means target missing today)${NC}"
if ((${#INTERNAL_LINES[@]} == 0)); then
  echo -e "${YELLOW}(none)${NC}"
else
  printf "%b\n" "${INTERNAL_LINES[@]}"
fi
echo

# ---- 3) External ----
echo -e "${BOLD}${RED}== 3: External Symlinks (${FOLDER_ABS} -> Outside) ==${NC}"
echo -e "${CYAN}(Relative external links may break if moved; [BROKEN NOW] means target missing today)${NC}"
if ((${#EXTERNAL_LINES[@]} == 0)); then
  echo -e "${YELLOW}(none)${NC}"
else
  printf "%b\n" "${EXTERNAL_LINES[@]}"
fi
