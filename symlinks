#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  symlinks <folder> [--root <scan_root>] [--no-sudo] [--no-system-scan]

What it does:
  1) Lists all symlinks *within* <folder> (recursive) showing:
     LINK_PATH -> RAW_TARGET (resolved: ABSOLUTE_TARGET)

  2) Uses fd to search for symlinks under <scan_root> (default "/") whose
     resolved target points *into* <folder>.

Options:
  --root <scan_root>    Where to scan for "incoming" links (default "/")
  --no-sudo             Do not use sudo for the system scan
  --no-system-scan      Only list symlinks inside <folder>, skip the fd scan
EOF
}

# ---- argument parsing ----
if [[ $# -lt 1 ]]; then usage; exit 2; fi

FOLDER="${1:-}"; shift || true
SCAN_ROOT="/"
USE_SUDO="auto"
DO_SYSTEM_SCAN=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --root)
      SCAN_ROOT="${2:?--root requires a path}"; shift 2
      ;;
    --no-sudo)
      USE_SUDO="no"; shift
      ;;
    --no-system-scan)
      DO_SYSTEM_SCAN=0; shift
      ;;
    -h|--help)
      usage; exit 0
      ;;
    *)
      echo "Unknown arg: $1" >&2
      usage
      exit 2
      ;;
  esac
done

# ---- colors ----
RED=$'\e[0;31m'
GREEN=$'\e[0;32m'
YELLOW=$'\e[1;33m'
BLUE=$'\e[0;34m'
PURPLE=$'\e[0;35m'
CYAN=$'\e[0;36m'
BOLD=$'\e[1m'
NC=$'\e[0m'

# ---- tool detection ----
FD_BIN=""
if command -v fd >/dev/null 2>&1; then
  FD_BIN="fd"
elif command -v fdfind >/dev/null 2>&1; then
  FD_BIN="fdfind"
fi

if ! command -v readlink >/dev/null 2>&1; then
  echo -e "${RED}Error: readlink not found.${NC}" >&2
  exit 1
fi

# GNU coreutils realpath preferred; fallback to python if missing
resolve_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath -m -- "$1"
  else
    python3 - <<'PY' "$1"
import os, sys
p = sys.argv[1]
print(os.path.normpath(os.path.abspath(p)))
PY
  fi
}

# Normalize path without following symlinks
normalize_path_no_follow() {
  python3 - <<'PY' "$1"
import os, sys
print(os.path.normpath(sys.argv[1]))
PY
}

FOLDER_ABS="$(resolve_path "$FOLDER")"
export FOLDER_ABS
SCAN_ROOT_ABS="$(resolve_path "$SCAN_ROOT")"

# ---- helper: print symlink ----
print_link() {
  local link="$1"
  local raw="$2"
  local resolved="$3"
  local color="$4"
  local is_broken="${5:-0}"
  
  local marker=""
  if [[ "$is_broken" -eq 1 ]]; then
    marker=" ${BOLD}${RED}[BROKEN IF MOVED]${NC}"
  fi
  
  printf "${color}%s${NC} -> ${YELLOW}%s${NC} (${CYAN}resolved: %s${NC})%s\n" "$link" "$raw" "$resolved" "$marker"
}
export -f print_link
export -f resolve_path
export NC YELLOW CYAN RED GREEN BLUE PURPLE BOLD

# ---- 1) Incoming: Symlinks from other folders to the current folder ----
if [[ "$DO_SYSTEM_SCAN" -eq 1 ]]; then
  if [[ -z "$FD_BIN" ]]; then
    echo -e "${YELLOW}Warning: fd/fdfind not found; skipping incoming scan.${NC}" >&2
  else
    sudo_prefix=()
    if [[ "$USE_SUDO" == "auto" ]]; then
      if [[ "${EUID:-$(id -u)}" -ne 0 ]] && command -v sudo >/dev/null 2>&1; then
        sudo_prefix=(sudo)
      fi
    fi

    echo -e "${BOLD}${PURPLE}== 1: Incoming Symlinks (Outside -> ${FOLDER_ABS}) ==${NC}"
    echo -e "${CYAN}(These break because they point to this specific folder path)${NC}"
    "${sudo_prefix[@]}" "$FD_BIN" -t l -H . "$SCAN_ROOT_ABS" \
      -E proc -E sys -E dev -E run -E mnt -E tmp -E .git -E .cache -E node_modules \
      -x bash -c '
        folder_abs="$1"; shift
        BLUE=$'\''\e[0;34m'\''
        YELLOW=$'\''\e[1;33m'\''
        CYAN=$'\''\e[0;36m'\''
        RED=$'\''\e[0;31m'\''
        BOLD=$'\''\e[1m'\''
        NC=$'\''\e[0m'\''
        for link in "$@"; do
          [[ "$link" == "$folder_abs" || "$link" == "$folder_abs"/* ]] && continue
          
          # We use fully resolved path to see if it eventually points to our folder
          resolved=$(realpath -m "$link" 2>/dev/null || true)
          [[ -z "$resolved" ]] && continue
          
          if [[ "$resolved" == "$folder_abs" || "$resolved" == "$folder_abs"/* ]]; then
            raw=$(readlink "$link" || true)
            [[ -z "$raw" ]] && continue
            printf "${BLUE}%s${NC} -> ${YELLOW}%s${NC} (${CYAN}resolved: %s${NC}) ${BOLD}${RED}[BROKEN IF MOVED]${NC}\n" "$link" "$raw" "$resolved"
          fi
        done
      ' bash "$FOLDER_ABS" {} +
    echo
  fi
fi

# ---- 2) Internal: Symlinks within the folder to other locations in the folder ----
echo -e "${BOLD}${GREEN}== 2: Internal Symlinks (${FOLDER_ABS} -> ${FOLDER_ABS}) ==${NC}"
echo -e "${CYAN}(Absolute internal links break; relative ones survive)${NC}"
find "$FOLDER_ABS" -type l -print0 2>/dev/null | while IFS= read -r -d '' link; do
  raw="$(readlink -- "$link" || true)"
  [[ -z "$raw" ]] && continue
  
  resolved="$(resolve_path "$link")"

  # Category 2: Fully resolved target is INSIDE the folder
  if [[ "$resolved" == "$FOLDER_ABS" || "$resolved" == "$FOLDER_ABS"/* ]]; then
    is_broken=0
    if [[ "$raw" == /* ]]; then
      # Absolute target: if it points inside FOLDER_ABS, it breaks on move
      # We already know resolved is inside, so if raw is absolute, it is broken.
      is_broken=1
    fi
    print_link "$link" "$raw" "$resolved" "$GREEN" "$is_broken"
  fi
done
echo

# ---- 3) External: Symlinks from the folder to outside locations ----
echo -e "${BOLD}${RED}== 3: External Symlinks (${FOLDER_ABS} -> Outside) ==${NC}"
echo -e "${CYAN}(Relative external links break; absolute ones to system paths survive)${NC}"
find "$FOLDER_ABS" -type l -print0 2>/dev/null | while IFS= read -r -d '' link; do
  raw="$(readlink -- "$link" || true)"
  [[ -z "$raw" ]] && continue

  resolved="$(resolve_path "$link")"

  # Category 3: Fully resolved target is OUTSIDE the folder
  if [[ "$resolved" != "$FOLDER_ABS" && "$resolved" != "$FOLDER_ABS"/* ]]; then
    is_broken=0
    # Determine IF THE IMMEDIATE TARGET is outside
    if [[ "$raw" != /* ]]; then
      # Resolve ONLY the immediate target without following sub-links
      # We use realpath -m which resolves .. but not the symlink itself
      immediate_target_abs=$(realpath -m "$(dirname -- "$link")/$raw")
      if [[ "$immediate_target_abs" != "$FOLDER_ABS" && "$immediate_target_abs" != "$FOLDER_ABS"/* ]]; then
        is_broken=1
      fi
    fi
    print_link "$link" "$raw" "$resolved" "$RED" "$is_broken"
  fi
done


